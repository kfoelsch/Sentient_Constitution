{
  "_comment": "AUDIT-EVIDENCE-RETENTION-01. Audit output under evidence/<date>/ keeps only the newest `keep` runs of each family; older runs are deleted by tools/prune_audit_evidence.py. Only files matching these names are touched. {date} is YYYY-MM-DD. Hand-written records in the same folders are never listed here.",
  "keep": 2,
  "families": {
    "ch1-cjs3-alignment": [
      "ch1_cjs3_principle_alignment_report_{date}.md",
