    ],
    "ch1-ch5-alignment": [
      "ch1_ch5_alignment_report_{date}.md",
      "ch1_ch5_traceability_matrix_{date}.csv",
      "ch1_ch5_audit_log_{date}.json"
    ],
    "ch1-ch6-alignment": [
      "ch1_ch6_alignment_report_{date}.md",
      "ch1_ch6_traceability_matrix_{date}.csv",
      "ch1_ch6_audit_log_{date}.json"
    ],
    "alignment-audit-index": [
      "alignment_audit_index_{date}.md",
      "alignment_audit_log_{date}.json"
    ],
    "ai-alignment-eval": [
      "ai_alignment_eval_report_{date}.md",
      "ai_alignment_eval_matrix_{date}.csv",
      "ai_alignment_eval_audit_log_{date}.json"
    ],
    "definition-appropriateness": [
      "definition_appropriateness_report_{date}.md",
