    "reference-integrity": ["REFERENCE_INTEGRITY_AUDIT_{date}.md"],
    "lexical-vocabulary": ["LEXICAL_VOCABULARY_AUDIT_{date}.md"],
    "plain-language": ["PLAIN_LANGUAGE_AUDIT_{date}.md"],
    "prose-continuity": ["PROSE_CONTINUITY_AUDIT_{date}.md"],
    "readability": ["READABILITY_AUDIT_{date}.md"],
    "readability-top-candidates": ["READABILITY_TOP_CANDIDATES_{date}.md"],
    "best-practices": ["BEST_PRACTICES_CHECK_{date}.md"]
  }
