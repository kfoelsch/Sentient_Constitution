{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "id_resolver.schema.json",
  "title": "AI corpus ID resolver",
  "type": "object",
  "required": [
    "generated_at",
    "status",
    "cannot_narrow_core",
    "ids",
    "topics",
    "definitions",
    "aliases",
    "steward_doors"
  ],
  "properties": {
    "generated_at": { "type": "string" },
    "status": { "const": "process_support_not_binding" },
    "cannot_narrow_core": { "const": true },
    "description": { "type": "string" },
    "ids": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["file", "kind"],
        "properties": {
          "file": { "type": "string" },
          "anchor": { "type": ["string", "null"] },
          "heading": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["family", "section", "cluster"] },
          "gloss": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "primary_owners", "read_with"],
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string" },
          "domain": { "type": "string" },
          "primary_owners": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "file": { "type": "string" },
                "anchor": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "read_with": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "file": { "type": "string" },
                "anchor": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "file", "anchor", "line_start", "line_end"],
        "properties": {
          "term": { "type": "string" },
          "file": { "type": "string" },
          "anchor": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "current_anchors", "fossil_anchors"],
        "properties": {
          "file": { "type": "string" },
          "title": { "type": "string" },
          "current_number": { "type": "string" },
          "current_anchors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fossil_anchors": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "steward_doors": {
      "type": "object",
      "required": ["index", "cards"],
      "properties": {
        "index": { "type": "string" },
        "cards": { "type": "string" },
        "case_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cases": { "type": "array" }
      },
      "additionalProperties": true
    },
    "lexical": { "type": "object" }
  },
  "additionalProperties": true
}
