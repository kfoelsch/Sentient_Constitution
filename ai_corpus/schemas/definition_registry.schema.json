{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "definition_registry.schema.json",
  "title": "AI corpus definition registry",
  "type": "object",
  "required": ["generated_at", "source", "definition_count", "definitions"],
  "properties": {
    "generated_at": { "type": "string" },
    "source": { "type": "string" },
    "definition_count": { "type": "integer", "minimum": 0 },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "source_file",
          "anchor",
          "line_start",
          "line_end",
          "category",
          "cluster_membership"
        ],
        "properties": {
          "term": { "type": "string" },
          "source_file": { "type": "string" },
          "anchor": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "category": {
            "enum": ["independent", "semi_independent", "dependent_cluster", "principle_layer"]
          },
          "cluster_membership": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["cluster", "cluster_file", "line"],
                "properties": {
                  "cluster": { "type": "string" },
                  "cluster_file": { "type": "string" },
                  "line": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
